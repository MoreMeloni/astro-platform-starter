<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Mini Game Fix</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  background: #111;
  color: white;
  text-align: center;
  overflow: hidden;
}

h1 {
  color: #00ff88;
}

#game {
  position: relative;
  width: 100%;
  height: 70vh;
  background: #222;
  overflow: hidden;
}

#player {
  position: absolute;
  bottom: 20px;
  left: 50px;
  width: 40px;
  height: 40px;
  background: #00ff88;
}

.block {
  position: absolute;
  bottom: 20px;
  width: 40px;
  height: 40px;
  background: red;
}

button {
  padding: 15px 30px;
  margin-top: 10px;
  font-size: 18px;
}
</style>
</head>

<body>

<h1>Mini Game</h1>

<div id="game">
  <div id="player"></div>
</div>

<button id="btn">Springen</button>

<script>
const player = document.getElementById("player");
const game = document.getElementById("game");
const btn = document.getElementById("btn");

let y = 0;
let jumping = false;

btn.onclick = () => {
  if (jumping) return;
  jumping = true;

  let up = setInterval(() => {
    if (y >= 120) {
      clearInterval(up);

      let down = setInterval(() => {
        if (y <= 0) {
          clearInterval(down);
          jumping = false;
        }
        y -= 5;
        player.style.bottom = (20 + y) + "px";
      }, 20);
    }

    y += 5;
    player.style.bottom = (20 + y) + "px";
  }, 20);
};

// BLOCK MOVEMENT FIXED
function spawnBlock() {
  const block = document.createElement("div");
  block.classList.add("block");
  block.style.left = "100%";
  game.appendChild(block);

  let pos = window.innerWidth;

  let move = setInterval(() => {
    pos -= 5;
    block.style.left = pos + "px";

    // collision
    if (pos < 90 && pos > 40 && y < 40) {
      alert("Game Over!");
      location.reload();
    }

    if (pos < -50) {
      block.remove();
      clearInterval(move);
    }
  }, 20);
}

setInterval(spawnBlock, 2000);
</script>

</body>
</html>
